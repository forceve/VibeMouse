<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VibeMouse.Panel.Views.MainWindow"
        Title="VibeMouse Panel"
        Width="460" Height="720"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        RequestedThemeVariant="Dark">

    <Grid>
        <Border CornerRadius="16"
                Background="#CC18181A"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Padding="24"
                PointerPressed="Card_PointerPressed">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <!-- ── Title bar ── -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🖱️" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="VibeMouse Panel"
                                       FontSize="17" FontWeight="Medium"
                                       Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕" Width="30" Height="30"
                                CornerRadius="15"
                                Background="Transparent"
                                Foreground="#66666666"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <!-- ── Separator ── -->
                    <Rectangle Grid.Row="1" Height="1" Fill="#1AFFFFFF" Margin="0,16,0,20"/>

                    <!-- ══ STATUS ══ -->
                    <StackPanel Grid.Row="2" Spacing="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,10">
                            <TextBlock Text="📡" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Status" FontSize="14" FontWeight="Medium" Foreground="#FFFFFFFF"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                            <TextBlock Text="Agent state" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0AFFFFFF" BorderBrush="#12FFFFFF"
                                    BorderThickness="1" CornerRadius="6" Padding="11,4">
                                <TextBlock x:Name="AgentStateText" Text="offline"
                                           Foreground="#88888888" FontSize="12" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                            <TextBlock Text="Listener mode" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0AFFFFFF" BorderBrush="#12FFFFFF"
                                    BorderThickness="1" CornerRadius="6" Padding="11,4">
                                <TextBlock x:Name="ListenerModeText" Text="unknown"
                                           Foreground="#4a4a50" FontSize="12"
                                           FontFamily="Consolas,Courier New,monospace"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Last transcript" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0AFFFFFF" BorderBrush="#12FFFFFF"
                                    BorderThickness="1" CornerRadius="6" Padding="11,4" MaxWidth="200">
                                <TextBlock x:Name="LastTranscriptText" Text="—"
                                           Foreground="#4a4a50" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxWidth="178"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ── Divider ── -->
                    <Rectangle Grid.Row="3" Height="1" Fill="#12FFFFFF" Margin="0,0,0,20"/>

                    <!-- ══ LISTENER + BINDINGS ══ -->
                    <StackPanel Grid.Row="4" Spacing="0" Margin="0,0,0,20">

                        <!-- Header with toggle -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎙️" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Listener" FontSize="15" FontWeight="Medium" Foreground="#FFFFFFFF"/>
                                </StackPanel>
                                <TextBlock x:Name="ListenerEditStatusText"
                                           Text="IPC commands only"
                                           FontSize="12" Foreground="#FF555555"
                                           Margin="23,0,0,0"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          x:Name="ListenerEditSwitch"
                                          OffContent="" OnContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="ListenerEditSwitch_IsCheckedChanged"/>
                        </Grid>

                        <!-- Thin rule -->
                        <Rectangle Height="1" Fill="#0DFFFFFF" Margin="0,12,0,10"/>

                        <!-- Bindings list — populated in code-behind via BuildBindingsList() -->
                        <StackPanel x:Name="BindingsList" Spacing="2"/>

                    </StackPanel>

                    <!-- ── Divider ── -->
                    <Rectangle Grid.Row="5" Height="1" Fill="#12FFFFFF" Margin="0,0,0,20"/>

                    <!-- ══ CONFIGURATION ══ -->
                    <StackPanel Grid.Row="6" Spacing="8" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                            <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Configuration" FontSize="14" FontWeight="Medium" Foreground="#FFFFFFFF"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Model" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="ModelCombo" Width="160"
                                      Background="#1AFFFFFF" BorderBrush="#26FFFFFF"
                                      Foreground="#E0E0E0" FontSize="12"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Language" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="LanguageBox" Width="160"
                                     Background="#1AFFFFFF" BorderBrush="#26FFFFFF"
                                     Foreground="#E0E0E0" FontSize="12" Watermark="auto"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Hotkey keycodes" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="HotkeyBox" Width="160"
                                     IsReadOnly="True"
                                     Background="#0AFFFFFF" BorderBrush="#12FFFFFF"
                                     Foreground="#4a4a50" FontSize="12" Watermark="default"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Log level" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="LogLevelCombo" Width="160"
                                      Background="#1AFFFFFF" BorderBrush="#26FFFFFF"
                                      Foreground="#E0E0E0" FontSize="12"/>
                        </Grid>

                        <Button x:Name="SaveButton" Content="Save Config"
                                HorizontalAlignment="Right"
                                Background="#22FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                Foreground="#E0E0E0" CornerRadius="6"
                                Padding="14,6" FontSize="13"
                                Click="SaveButton_Click"/>
                    </StackPanel>

                    <!-- ── Divider ── -->
                    <Rectangle Grid.Row="7" Height="1" Fill="#12FFFFFF" Margin="0,0,0,20"/>

                    <!-- ══ ACTIONS ══ -->
                    <StackPanel Grid.Row="8" Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,12">
                            <TextBlock Text="🎮" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Actions" FontSize="14" FontWeight="Medium" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReloadButton" Content="Reload Config"
                                    Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                    Foreground="#A0A0A0" CornerRadius="6" Padding="12,6" FontSize="12"
                                    Click="ReloadButton_Click"/>
                            <Button x:Name="DoctorButton" Content="Run Doctor"
                                    Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                    Foreground="#A0A0A0" CornerRadius="6" Padding="12,6" FontSize="12"
                                    Click="DoctorButton_Click"/>
                            <Button Content="Open Log Dir"
                                    Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                    Foreground="#A0A0A0" CornerRadius="6" Padding="12,6" FontSize="12"
                                    Click="OpenLogDirButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="IpcHintText"
                                   Text="IPC not available — agent not running"
                                   FontSize="11" Foreground="#4a4a50"
                                   Margin="0,8,0,0" IsVisible="False"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
